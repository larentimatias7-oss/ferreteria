---
import { tienda, buildWhatsAppUrl } from '../data/tienda';

const whatsappUrl = buildWhatsAppUrl(
  tienda.negocio.whatsappInternacional,
  `Hola ${tienda.negocio.nombre}, quisiera consultar stock y precios disponibles.`
);
---

<header class="fixed top-0 left-0 w-full z-50 bg-primary-container shadow-[0_2px_10px_rgba(0,0,0,0.3)] border-b border-primary">
  <div class="h-20 max-w-7xl mx-auto px-4 md:px-8 flex items-center justify-between gap-4">
    <!-- Brand / Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded bg-primary flex items-center justify-center border border-secondary-container/40 group-hover:border-secondary-container transition-colors">
        <svg class="w-6 h-6 text-secondary-container" viewBox="0 0 24 24" fill="currentColor">
          <path d="M5 4h3v6h8V4h3v16h-3v-7H8v7H5V4z"/>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-headline-sm text-headline-sm uppercase tracking-tight text-on-primary font-bold">
          {tienda.negocio.nombre}
        </span>
        <span class="font-label-badge text-label-badge text-secondary-container uppercase tracking-wider hidden sm:inline">
          Suministros Industriales
        </span>
      </div>
    </a>

    <!-- Contact Info (Desktop) -->
    <div class="hidden xl:flex items-center gap-4">
      <a
        href="#ubicacion"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-primary text-secondary-container font-label-md text-label-md hover:bg-primary/80 transition-colors"
      >
        <span class="material-symbols-outlined text-[16px]">location_on</span>
        <span>{tienda.negocio.direccion}</span>
      </a>
      <a
        href={`tel:${tienda.negocio.telefonoLlamadas.replace(/[^0-9]/g, '')}`}
        class="inline-flex items-center gap-1.5 font-label-md text-label-md text-on-primary-container hover:text-on-primary transition-colors"
      >
        <span class="material-symbols-outlined text-[16px]">call</span>
        <span>{tienda.negocio.telefonoLlamadas}</span>
      </a>
    </div>

    <!-- Navigation Anchors -->
    <nav class="hidden md:flex items-center gap-1">
      <a
        href="#ofertas"
        class="px-3 py-2 font-label-lg text-label-lg uppercase tracking-wider text-on-primary-container hover:bg-primary hover:text-on-primary rounded transition-colors"
      >
        Ofertas
      </a>
      <a
        href="#presupuestos"
        class="px-3 py-2 font-label-lg text-label-lg uppercase tracking-wider text-on-primary-container hover:bg-primary hover:text-on-primary rounded transition-colors"
      >
        Presupuestos
      </a>
      <a
        href="#ubicacion"
        class="px-3 py-2 font-label-lg text-label-lg uppercase tracking-wider text-on-primary-container hover:bg-primary hover:text-on-primary rounded transition-colors"
      >
        Ubicación
      </a>
    </nav>

    <!-- Header Direct CTA -->
    <div class="flex items-center gap-3">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2.5 bg-secondary-container hover:bg-secondary text-on-secondary-container hover:text-on-secondary font-label-lg text-label-lg uppercase rounded shadow-[0_2px_0px_#121519] active:translate-y-0.5 transition-all text-sm font-bold"
      >
        <span class="material-symbols-outlined text-[18px]">chat</span>
        <span class="hidden sm:inline">WhatsApp Directo</span>
        <span class="sm:hidden">WhatsApp</span>
      </a>
    </div>
  </div>
</header>
