---
import { tienda, buildWhatsAppUrl } from '../data/tienda';

const waUbicacionUrl = buildWhatsAppUrl(
  tienda.negocio.whatsappInternacional,
  `Hola ${tienda.negocio.nombre}, necesito coordinar retiro / entrega de materiales en ${tienda.negocio.direccion}.`
);
---

<section class="w-full bg-background py-12 md:py-20 px-4 md:px-8" id="ubicacion">
  <div class="max-w-7xl mx-auto space-y-8">
    <div class="space-y-2">
      <div class="font-label-badge text-label-badge uppercase tracking-widest text-secondary font-bold">
        Eje Logístico &amp; Retiro en Sucursal
      </div>
      <h2 class="font-headline-xl text-3xl sm:text-4xl uppercase text-on-surface font-extrabold">
        Ubicación y Atención Comercial
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Interactive Map Visual Box -->
      <div class="lg:col-span-7 bg-surface-container-lowest rounded-xl shadow-md overflow-hidden flex flex-col justify-between border border-outline-variant/40">
        <!-- Map header graphic / photo container -->
        <div class="w-full h-80 relative flex items-end p-4 md:p-6 bg-gradient-to-br from-primary-container via-slate-800 to-primary">
          <!-- Geometric Blueprint Graphic Overlay -->
          <div
            class="absolute inset-0 opacity-20 pointer-events-none"
            style="background-image: linear-gradient(#ffffff 1px, transparent 1px), linear-gradient(90deg, #ffffff 1px, transparent 1px); background-size: 24px 24px;"
          ></div>

          <div class="relative z-10 bg-surface-container-lowest/95 backdrop-blur p-4 rounded shadow-lg flex items-center justify-between w-full border border-outline-variant/40">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded bg-primary text-secondary-container flex items-center justify-center font-extrabold text-lg border border-secondary-container/40">
                26S
              </div>
              <div>
                <div class="font-label-md text-label-md text-on-surface uppercase font-bold">
                  {tienda.negocio.direccion}
                </div>
                <div class="font-body-sm text-body-sm text-on-surface-variant">
                  Acceso directo asfaltado para camiones y acoplados
                </div>
              </div>
            </div>

            <a
              class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 bg-primary-container hover:bg-primary text-on-primary font-label-badge text-label-badge uppercase rounded transition-colors shadow font-bold"
              href={tienda.negocio.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Cómo llegar</span>
              <span class="material-symbols-outlined text-[16px]">open_in_new</span>
            </a>
          </div>
        </div>

        <!-- Facility Badges -->
        <div class="p-4 bg-surface-container-low flex flex-wrap items-center justify-between gap-4 border-t border-outline-variant/30">
          <div class="flex items-center gap-2 font-label-md text-label-md text-on-surface font-semibold">
            <span class="material-symbols-outlined text-secondary text-[22px]">local_parking</span>
            <span>Playa de estacionamiento libre para camionetas y trailers</span>
          </div>
          <div class="flex items-center gap-2 font-label-md text-label-md text-on-surface font-semibold">
            <span class="material-symbols-outlined text-secondary text-[22px]">forklift</span>
            <span>Grúa y autoelevador de carga pesada</span>
          </div>
        </div>
      </div>

      <!-- Contact Information Cards Panel -->
      <div class="lg:col-span-5 space-y-4">
        <div class="bg-surface-container-lowest p-6 rounded-xl shadow-sm space-y-5 border border-outline-variant/40">
          <h3 class="font-headline-sm text-xl uppercase text-on-surface font-bold">
            Datos de Contacto Directo
          </h3>

          <div class="space-y-4">
            <!-- Dirección -->
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-secondary text-[24px] mt-0.5">place</span>
              <div>
                <strong class="font-label-md text-label-md uppercase text-on-surface block font-bold">
                  Dirección de Mostrador
                </strong>
                <p class="font-body-md text-body-md text-on-surface-variant">
                  {tienda.negocio.direccion} (Frente al corredor logístico)
                </p>
                <a
                  href={tienda.negocio.googleMapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-xs text-secondary hover:underline font-bold mt-1 uppercase"
                >
                  <span>Abrir en Google Maps</span>
                  <span class="material-symbols-outlined text-[14px]">open_in_new</span>
                </a>
              </div>
            </div>

            <!-- Teléfono -->
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-secondary text-[24px] mt-0.5">call</span>
              <div>
                <strong class="font-label-md text-label-md uppercase text-on-surface block font-bold">
                  Línea de Mostrador
                </strong>
                <p class="font-body-md text-body-md text-on-surface-variant">
                  <a href={`tel:${tienda.negocio.telefonoLlamadas.replace(/[^0-9]/g, '')}`} class="hover:underline font-semibold">
                    {tienda.negocio.telefonoLlamadas}
                  </a>
                  (Llamadas y presupuestos directos)
                </p>
              </div>
            </div>

            <!-- WhatsApp -->
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-secondary text-[24px] mt-0.5">chat</span>
              <div>
                <strong class="font-label-md text-label-md uppercase text-on-surface block font-bold">
                  WhatsApp Gremio y Obras
                </strong>
                <a
                  class="font-label-md text-label-md text-secondary hover:underline font-bold inline-block"
                  href={waUbicacionUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {tienda.negocio.whatsappDisplay}
                </a>
              </div>
            </div>

            <!-- Horarios -->
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-secondary text-[24px] mt-0.5">schedule</span>
              <div>
                <strong class="font-label-md text-label-md uppercase text-on-surface block font-bold">
                  Horario de Atención
                </strong>
                <p class="font-body-md text-body-md text-on-surface-variant">
                  {tienda.negocio.horarioSemana}
                </p>
                <p class="font-body-md text-body-md text-on-surface-variant">
                  {tienda.negocio.horarioSabado}
                </p>
              </div>
            </div>
          </div>

          <!-- Direct Quick Call Button -->
          <a
            class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-primary hover:bg-primary-container text-on-primary font-label-lg text-label-lg uppercase rounded shadow-[0_3px_0px_#121519] active:translate-y-0.5 transition-all font-bold text-center border border-primary-fixed-dim/20"
            href={`tel:${tienda.negocio.telefonoLlamadas.replace(/[^0-9]/g, '')}`}
          >
            <span class="material-symbols-outlined text-[20px]">phone_in_talk</span>
            <span>Llamar al Mostrador ({tienda.negocio.telefonoLlamadas})</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
