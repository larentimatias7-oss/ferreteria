---
import { tienda, buildWhatsAppUrl } from '../data/tienda';

const waUbicacionUrl = buildWhatsAppUrl(
  tienda.negocio.whatsappInternacional,
  `Hola ${tienda.negocio.nombre}, necesito consultar cómo llegar o coordinar retiro/entrega de materiales en ${tienda.negocio.direccionCompleta}.`
);
const cleanPhone = tienda.negocio.telefonoLlamadas.replace(/[^0-9]/g, '');
---

<section class="w-full bg-background py-14 md:py-20 px-4 md:px-8 border-b border-outline-variant/30" id="ubicacion">
  <div class="max-w-7xl mx-auto space-y-8">
    <div class="space-y-2">
      <div class="font-label-badge text-label-badge uppercase tracking-widest text-secondary font-bold">
        Ubicación Estratégica en Andino
      </div>
      <h2 class="font-headline-xl text-3xl sm:text-4xl uppercase text-on-surface font-extrabold">
        Dónde Encontrarnos y Cómo Llegar
      </h2>
      <p class="text-on-surface-variant max-w-2xl text-base">
        Visitanos en nuestro salón de ventas en Pueblo Andino. Estacionamiento propio y carga directa para autos, camionetas y trailers.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Interactive Map / Location Box -->
      <div class="lg:col-span-7 bg-surface-container-lowest rounded-2xl shadow-md overflow-hidden flex flex-col justify-between border border-outline-variant/40">
        <!-- Google Maps Embed -->
        <div class="w-full h-80 sm:h-96 relative bg-slate-100 overflow-hidden">
          <iframe
            src={tienda.negocio.googleMapsEmbed}
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={`Mapa de ubicación ${tienda.negocio.nombre} en ${tienda.negocio.direccionCompleta}`}
            class="w-full h-full"
          ></iframe>

          <!-- Floating Pin Badge -->
          <div class="absolute top-3 left-3 bg-slate-900/90 text-white backdrop-blur px-3 py-1.5 rounded-lg shadow-lg flex items-center gap-2 border border-white/20 text-xs">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="font-bold">{tienda.negocio.nombre} • {tienda.negocio.direccion}</span>
          </div>
        </div>

        <!-- Address Bar Below Map -->
        <div class="p-4 bg-surface-container-low flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-t border-outline-variant/30">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-primary text-secondary-container flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[22px]">pin_drop</span>
            </div>
            <div>
              <div class="font-headline-sm text-sm uppercase text-on-surface font-extrabold">
                {tienda.negocio.direccionCompleta}
              </div>
              <div class="font-body-sm text-xs text-on-surface-variant">
                Pueblo Andino, Departamento Iriondo, Santa Fe
              </div>
            </div>
          </div>

          <a
            class="inline-flex items-center gap-1.5 px-4 py-2 bg-secondary-container hover:bg-secondary text-on-secondary-container hover:text-on-secondary font-label-badge text-label-badge uppercase rounded transition-colors shadow font-bold text-xs shrink-0"
            href={tienda.negocio.googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>Abrir en Google Maps</span>
            <span class="material-symbols-outlined text-[16px]">open_in_new</span>
          </a>
        </div>

        <!-- Facility Badges -->
        <div class="p-4 bg-surface-container-lowest flex flex-wrap items-center justify-between gap-3 border-t border-outline-variant/30 text-xs">
          <div class="flex items-center gap-1.5 font-semibold text-slate-700">
            <span class="material-symbols-outlined text-secondary text-[20px]">local_parking</span>
            <span>Estacionamiento y carga ágil</span>
          </div>
          <div class="flex items-center gap-1.5 font-semibold text-slate-700">
            <span class="material-symbols-outlined text-emerald-600 text-[20px]">store</span>
            <span>Salón de ventas y atención en mostrador</span>
          </div>
        </div>
      </div>

      <!-- Contact Information Cards Panel -->
      <div class="lg:col-span-5 space-y-4">
        <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-sm space-y-5 border border-outline-variant/40">
          <div class="flex items-center justify-between border-b border-outline-variant/30 pb-3">
            <h3 class="font-headline-sm text-xl uppercase text-on-surface font-extrabold">
              Datos Oficiales
            </h3>
            <span class="bg-emerald-100 text-emerald-800 text-[11px] font-bold px-2 py-0.5 rounded uppercase">
              Abierto en Andino
            </span>
          </div>

          <div class="space-y-4">
            <!-- Dirección Real -->
            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
                <span class="material-symbols-outlined text-[20px] text-secondary">location_on</span>
              </div>
              <div>
                <strong class="font-label-md text-xs uppercase text-on-surface block font-bold">
                  Dirección del Local
                </strong>
                <p class="font-body-md text-sm text-on-surface font-semibold">
                  {tienda.negocio.direccion}
                </p>
                <p class="font-body-sm text-xs text-on-surface-variant">
                  Andino - Santa Fe (CP S2214)
                </p>
              </div>
            </div>

            <!-- Teléfono Real -->
            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
                <span class="material-symbols-outlined text-[20px] text-secondary">call</span>
              </div>
              <div>
                <strong class="font-label-md text-xs uppercase text-on-surface block font-bold">
                  Consultas y Pedidos
                </strong>
                <a href={`tel:${cleanPhone}`} class="font-headline-sm text-lg text-primary hover:text-secondary font-extrabold block">
                  {tienda.negocio.telefonoLlamadas}
                </a>
                <span class="text-xs text-on-surface-variant">Llamadas telefónicas y línea comercial</span>
              </div>
            </div>

            <!-- WhatsApp Real -->
            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5">
                <span class="material-symbols-outlined text-[20px]">chat</span>
              </div>
              <div>
                <strong class="font-label-md text-xs uppercase text-on-surface block font-bold">
                  Tomamos Pedidos por WhatsApp
                </strong>
                <a
                  class="font-headline-sm text-lg text-emerald-600 hover:text-emerald-700 font-extrabold block"
                  href={waUbicacionUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {tienda.negocio.whatsappDisplay}
                </a>
                <span class="text-xs text-on-surface-variant">Envianos fotos, planos o listas de materiales</span>
              </div>
            </div>

            <!-- Horarios -->
            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
                <span class="material-symbols-outlined text-[20px] text-secondary">schedule</span>
              </div>
              <div>
                <strong class="font-label-md text-xs uppercase text-on-surface block font-bold">
                  Horarios de Atención
                </strong>
                <p class="font-body-sm text-xs text-on-surface-variant">
                  {tienda.negocio.horarioSemana}
                </p>
                <p class="font-body-sm text-xs text-on-surface-variant">
                  {tienda.negocio.horarioSabado}
                </p>
              </div>
            </div>
          </div>

          <!-- Direct Quick WhatsApp Button -->
          <a
            class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white font-label-lg text-label-lg uppercase rounded shadow active:translate-y-0.5 transition-all font-bold text-center"
            href={waUbicacionUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="material-symbols-outlined text-[20px]">chat</span>
            <span>Escribir al WhatsApp ({tienda.negocio.whatsappDisplay})</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
