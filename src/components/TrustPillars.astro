---
import { tienda } from '../data/tienda';

const pillars = tienda.pilares;
---

<section class="w-full bg-surface-container-lowest py-10 md:py-14 px-4 md:px-8 border-b border-outline-variant/30">
  <div class="max-w-7xl mx-auto">
    <div class="text-center max-w-xl mx-auto mb-8 space-y-1">
      <span class="font-label-badge text-label-badge uppercase tracking-widest text-secondary font-bold">
        Garantía y Compromiso
      </span>
      <h2 class="font-headline-sm text-2xl uppercase font-extrabold text-on-surface">
        Por qué elegir a H-Ferretería
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {
        pillars.map((item) => (
          <div class="bg-surface-container-low p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between border border-outline-variant/40 group">
            <div class="space-y-3">
              <div class="w-12 h-12 rounded-lg bg-primary text-secondary-container flex items-center justify-center group-hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-[28px]">{item.icono}</span>
              </div>
              <h3 class="font-headline-sm text-base uppercase text-on-surface font-extrabold tracking-tight">
                {item.titulo}
              </h3>
              <p class="font-body-sm text-sm text-on-surface-variant leading-relaxed">
                {item.descripcion}
              </p>
            </div>
            <span class="inline-block mt-4 font-label-badge text-label-badge uppercase tracking-wider text-secondary font-bold">
              {item.tag}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
