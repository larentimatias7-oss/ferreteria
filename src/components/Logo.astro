---
interface Props {
  variant?: 'full' | 'compact' | 'mark';
  theme?: 'dark' | 'light';
  class?: string;
  showSlogan?: boolean;
}

const {
  variant = 'compact',
  theme = 'dark',
  class: className = '',
  showSlogan = false,
} = Astro.props;

const isLight = theme === 'light';
const textColor = isLight ? '#12161c' : '#ffffff';
const orange = '#ff6e00';
---

{variant === 'mark' ? (
  <svg
    class={`h-10 w-auto select-none ${className}`}
    viewBox="0 0 170 120"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-label="H-Ferretería"
  >
    <!-- Gabled Roof structure -->
    <path d="M 8 70 L 118 12 L 168 47 L 158 59 L 118 28 L 22 79 Z" fill={orange} />

    <!-- 3 Vertical Pillars under left slope -->
    <rect x="22" y="78" width="11" height="34" fill={orange} />
    <rect x="42" y="67" width="11" height="45" fill={orange} />
    <rect x="62" y="56" width="11" height="56" fill={orange} />

    <!-- LETTER 'H' -->
    <rect x="85" y="38" width="18" height="74" fill={textColor} />
    <rect x="103" y="65" width="26" height="18" fill={textColor} />
    <rect x="129" y="38" width="18" height="74" fill={textColor} />
  </svg>
) : variant === 'compact' ? (
  <svg
    class={`h-9 sm:h-11 md:h-12 w-auto select-none overflow-visible ${className}`}
    viewBox="0 0 710 130"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-label="H-Ferretería"
  >
    <defs>
      <style>
        @import url('https://fonts.googleapis.com/css2?family=Chivo:wght@900&display=swap');
        .header-brand-title {'{'}
          font-family: 'Chivo', 'Arial Black', Impact, sans-serif;
          font-weight: 900;
        {'}'}
      </style>
    </defs>

    <!-- Gabled Roof structure in brand orange -->
    <path d="M 14 70 L 135 14 L 224 55 L 213 67 L 135 30 L 28 80 Z" fill={orange} />

    <!-- 3 Vertical Pillars supporting left overhang -->
    <rect x="27" y="77" width="12" height="34" fill={orange} />
    <rect x="49" y="66" width="12" height="45" fill={orange} />
    <rect x="71" y="55" width="12" height="56" fill={orange} />

    <!-- LETTER 'H' (Bold white within house frame) -->
    <rect x="96" y="38" width="20" height="73" fill={textColor} />
    <rect x="116" y="65" width="28" height="19" fill={textColor} />
    <rect x="144" y="38" width="20" height="73" fill={textColor} />

    <!-- ORANGE HYPHEN '-' -->
    <rect x="176" y="66" width="18" height="17" rx="2" fill={orange} />

    <!-- WORDMARK: FERRETERÍA (With ample width so it never clips) -->
    <text
      x="204"
      y="111"
      fill={textColor}
      class="header-brand-title"
      font-size="64"
      letter-spacing="1.5"
    >
      FERRETERÍA
    </text>

    {showSlogan && (
      <text
        x="26"
        y="134"
        fill={textColor}
        font-family="'Space Grotesk', 'Arial', sans-serif"
        font-weight="700"
        font-size="14"
        letter-spacing="3.8"
        opacity="0.95"
      >
        TU PROYECTO, EN LAS MEJORES MANOS
      </text>
    )}
  </svg>
) : (
  <svg
    class={`w-full max-w-lg h-auto select-none overflow-visible ${className}`}
    viewBox="0 0 710 152"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-label="H-Ferretería - Tu proyecto, en las mejores manos"
  >
    <defs>
      <style>
        @import url('https://fonts.googleapis.com/css2?family=Chivo:wght@900&family=Space+Grotesk:wght@700&display=swap');
        .hero-brand-title {'{'}
          font-family: 'Chivo', 'Arial Black', Impact, sans-serif;
          font-weight: 900;
        {'}'}
        .hero-brand-slogan {'{'}
          font-family: 'Space Grotesk', 'Arial', sans-serif;
          font-weight: 700;
        {'}'}
      </style>
    </defs>

    <!-- Gabled Roof structure -->
    <path d="M 14 70 L 135 14 L 224 55 L 213 67 L 135 30 L 28 80 Z" fill={orange} />

    <!-- 3 Vertical Pillars -->
    <rect x="27" y="77" width="12" height="34" fill={orange} />
    <rect x="49" y="66" width="12" height="45" fill={orange} />
    <rect x="71" y="55" width="12" height="56" fill={orange} />

    <!-- LETTER 'H' -->
    <rect x="96" y="38" width="20" height="73" fill={textColor} />
    <rect x="116" y="65" width="28" height="19" fill={textColor} />
    <rect x="144" y="38" width="20" height="73" fill={textColor} />

    <!-- ORANGE HYPHEN '-' -->
    <rect x="176" y="66" width="18" height="17" rx="2" fill={orange} />

    <!-- WORDMARK: FERRETERÍA -->
    <text
      x="204"
      y="111"
      fill={textColor}
      class="hero-brand-title"
      font-size="64"
      letter-spacing="1.5"
    >
      FERRETERÍA
    </text>

    <!-- SLOGAN -->
    <text
      x="26"
      y="140"
      fill={textColor}
      class="hero-brand-slogan"
      font-size="14.5"
      letter-spacing="3.8"
      opacity="0.95"
    >
      TU PROYECTO, EN LAS MEJORES MANOS
    </text>
  </svg>
)}
