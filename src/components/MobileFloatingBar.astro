---
import { tienda, buildWhatsAppUrl } from '../data/tienda';

const waMobileUrl = buildWhatsAppUrl(
  tienda.negocio.whatsappInternacional,
  `Hola ${tienda.negocio.nombre}! Quisiera consultar precios de las ofertas de Gran Apertura y disponibilidad de materiales.`
);
const cleanPhone = tienda.negocio.telefonoLlamadas.replace(/[^0-9]/g, '');
---

<!-- Barra Flotante Móvil (390px) -->
<aside class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-primary/95 backdrop-blur-md border-t-2 border-primary-container shadow-[0_-4px_20px_rgba(0,0,0,0.5)] px-3 py-2 pb-safe">
  <div class="max-w-md mx-auto grid grid-cols-2 gap-2">
    <!-- Botón de Llamada Directa con Teléfono Real -->
    <a
      href={`tel:${cleanPhone}`}
      class="inline-flex items-center justify-center gap-2 h-12 bg-primary-container hover:bg-slate-800 text-white font-label-md text-label-md uppercase rounded shadow active:translate-y-0.5 transition-all font-bold border border-white/20 text-center"
      aria-label={`Llamar a ${tienda.negocio.nombre} al ${tienda.negocio.telefonoLlamadas}`}
    >
      <span class="material-symbols-outlined text-[20px] text-secondary-container">call</span>
      <span class="text-xs tracking-wider">Llamar Mostrador</span>
    </a>

    <!-- Botón Verde de WhatsApp Directo con Número Real -->
    <a
      href={waMobileUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2 h-12 bg-emerald-600 hover:bg-emerald-700 text-white font-label-md text-label-md uppercase rounded shadow active:translate-y-0.5 transition-all font-bold text-center"
      aria-label="Consultar por WhatsApp"
    >
      <span class="material-symbols-outlined text-[20px]">chat</span>
      <span class="text-xs tracking-wider">WhatsApp Pedidos</span>
    </a>
  </div>
</aside>
