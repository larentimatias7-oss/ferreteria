---
import type { Producto } from '../data/tienda';
import { tienda, formatearMoneda, buildWhatsAppUrl } from '../data/tienda';

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;
const waUrl = buildWhatsAppUrl(tienda.negocio.whatsappInternacional, producto.mensajeWhatsApp);

function getBadgeClasses(tipo?: string) {
  switch (tipo) {
    case 'gremio':
      return 'bg-tertiary-container text-on-tertiary-container';
    case 'stock':
      return 'bg-primary text-on-primary';
    case 'combo':
    case 'oferta':
    default:
      return 'bg-secondary-container text-on-secondary-container';
  }
}
---

<div class="bg-surface-container-lowest rounded shadow-sm hover:shadow-md transition-all flex flex-col justify-between overflow-hidden border border-outline-variant/40 group">
  <!-- Image + Top Badge -->
  <div>
    <div class="relative bg-surface-container-low aspect-[4/3] flex items-center justify-center overflow-hidden">
      <img
        src={producto.imagen}
        alt={producto.nombre}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
      {producto.badge && (
        <span class={`absolute top-2 left-2 font-label-badge text-label-badge px-2 py-0.5 rounded font-bold shadow uppercase tracking-wider ${getBadgeClasses(producto.badgeTipo)}`}>
          {producto.badge}
        </span>
      )}
    </div>

    <!-- Body Information -->
    <div class="p-4 space-y-2">
      <div class="flex items-center justify-between text-xs">
        <span class="font-label-badge text-label-badge uppercase text-secondary font-bold">
          {producto.categoria || 'Catálogo Obra'}
        </span>
        <span class="font-label-badge text-label-badge text-on-surface-variant">
          Stock Inmediato
        </span>
      </div>

      <h3 class="font-headline-sm text-base uppercase text-on-surface font-bold leading-snug">
        {producto.nombre}
      </h3>

      <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2 leading-relaxed">
        {producto.descripcion}
      </p>
    </div>
  </div>

  <!-- Price & CTAs -->
  <div class="p-4 pt-0 space-y-3">
    <div class="border-t border-surface-container-high pt-2">
      {producto.precioAnterior && (
        <span class="font-body-sm text-body-sm text-on-surface-variant line-through block font-medium">
          {formatearMoneda(producto.precioAnterior, producto.moneda)}
        </span>
      )}
      <div class="font-price-display text-2xl text-on-surface leading-tight font-extrabold">
        {formatearMoneda(producto.precio, producto.moneda)}
      </div>
      <span class="font-label-badge text-label-badge text-on-surface-variant">
        {producto.unidad || 'Precio de contado / Transf.'}
      </span>
    </div>

    <!-- 2 Buttons: Comprar Online & WhatsApp -->
    <div class="grid grid-cols-2 gap-2">
      <a
        href={producto.linkMercadoPago}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center py-2 px-2 bg-secondary-container text-on-secondary-container hover:bg-secondary hover:text-on-secondary font-label-md text-label-md uppercase rounded transition-colors text-center font-bold text-xs"
      >
        Comprar
      </a>
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center py-2 px-2 bg-primary-container text-on-primary hover:bg-primary font-label-md text-label-md uppercase rounded transition-colors text-center font-bold text-xs"
      >
        WhatsApp
      </a>
    </div>
  </div>
</div>
